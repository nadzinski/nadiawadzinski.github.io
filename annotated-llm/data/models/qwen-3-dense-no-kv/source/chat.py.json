{"lines":["import argparse","import os","import sys","","import torch","","from model import CONFIG","from sampling import sample_token","from tokenizer import ChatTokenizer","from weights import choose_device, download_files, load_model","","","def generate_tokens(model, tokenizer, messages, max_new_tokens=256, temperature=0.7, top_k=20, top_p=0.8, think=False):","    device = next(model.parameters()).device","    prompt = tokenizer.encode_chat(messages, think=think)","    remaining = CONFIG[\"max_seq_len\"] - len(prompt)","    if remaining <= 0:","        raise ValueError(\"The conversation is too long. Use /clear to start again.\")","","    tokens = torch.tensor(prompt, dtype=torch.long, device=device)","    for _ in range(min(max_new_tokens, remaining)):","        logits = model(tokens)[-1, :tokenizer.vocabulary_size]","        token_id = sample_token(logits, temperature, top_k, top_p)","        if token_id in tokenizer.stop_ids:","            return","        yield token_id","        # With no KV cache, the next pass processes the entire conversation again.","        tokens = torch.cat((tokens, tokens.new_tensor([token_id])))","","","def main():","    parser = argparse.ArgumentParser(description=\"Chat with our Qwen3-0.6B implementation.\")","    parser.add_argument(\"--device\", choices=(\"auto\", \"mps\", \"cuda\", \"cpu\"), default=\"auto\")","    parser.add_argument(\"--think\", action=\"store_true\", help=\"show the model's thinking before its answer\")","    parser.add_argument(\"--temperature\", type=float, help=\"default: 0.7, or 0.6 with --think; 0 selects the most likely token\")","    parser.add_argument(\"--top-k\", type=int, default=20, help=\"0 disables the top-k filter\")","    parser.add_argument(\"--top-p\", type=float, help=\"default: 0.8, or 0.95 with --think\")","    parser.add_argument(\"--max-new-tokens\", type=int, default=256)","    parser.add_argument(\"--seed\", type=int)","    args = parser.parse_args()","    if args.temperature is None:","        args.temperature = 0.6 if args.think else 0.7","    if args.top_p is None:","        args.top_p = 0.95 if args.think else 0.8","    if not args.temperature >= 0 or args.top_k < 0 or not 0 < args.top_p <= 1 or args.max_new_tokens < 1:","        parser.error(\"Use temperature >= 0, top-k >= 0, 0 < top-p <= 1, and max-new-tokens >= 1.\")","","    for stream in (sys.stdin, sys.stdout, sys.stderr):","        if hasattr(stream, \"reconfigure\"):","            stream.reconfigure(encoding=\"utf-8\")","    if args.seed is not None:","        torch.manual_seed(args.seed)","    try:","        device = choose_device(args.device)","    except ValueError as error:","        parser.error(str(error))","","    print(f\"Loading Qwen3-0.6B on {device}…\")","    directory = download_files()","    tokenizer = ChatTokenizer(directory)","    model = load_model(directory, device)","    print(\"Ready. /clear starts over; /quit or Ctrl+C exits.\\n\")","","    color = sys.stdout.isatty() and \"NO_COLOR\" not in os.environ","    user_color, model_color, reset = (\"\\033[36m\", \"\\033[32m\", \"\\033[0m\") if color else (\"\", \"\", \"\")","    thinking_color = \"\\033[2;37m\" if color else \"\"","    system = {\"role\": \"system\", \"content\": \"You are a helpful assistant.\"}","    history = [system]","","    try:","        while True:","            text = input(f\"{user_color}You: \")","            print(reset, end=\"\", flush=True)","            if text.strip() in (\"/quit\", \"/exit\"):","                break","            if text.strip() == \"/clear\":","                history = [system]","                print(\"Conversation cleared.\\n\")","                continue","            if not text.strip():","                continue","","            messages = history + [{\"role\": \"user\", \"content\": text}]","            token_ids = generate_tokens(","                model, tokenizer, messages, args.max_new_tokens,","                args.temperature, args.top_k, args.top_p, think=args.think,","            )","            pieces = []","            previous_thinking = None","            try:","                for piece, thinking in tokenizer.stream_decode(token_ids):","                    if thinking != previous_thinking:","                        if previous_thinking is not None:","                            print()","                        label = \"LLM (thinking)\" if thinking else \"LLM\"","                        text_color = thinking_color if thinking else model_color","                        print(f\"{reset}{text_color}{label}: \", end=\"\", flush=True)","                        previous_thinking = thinking","                    if not thinking:","                        pieces.append(piece)","                    print(piece, end=\"\", flush=True)","            except ValueError as error:","                print(f\"{reset}\\n{error}\\n\")","                continue","            finally:","                print(reset, end=\"\", flush=True)","            print(\"\\n\")","            history = messages + [{\"role\": \"assistant\", \"content\": \"\".join(pieces)}]","    except (EOFError, KeyboardInterrupt):","        print(f\"{reset}\\nBye.\")","","","if __name__ == \"__main__\":","    main()"]}
